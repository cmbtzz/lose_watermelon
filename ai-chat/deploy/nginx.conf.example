# 部署前把 ASTRBOT_OR_PROXY_PORT 替换为当前服务器实测确认的端口。
# 若 AstrBot 需要浏览器不应持有的 Token，请让 /api/ 指向薄代理层。
limit_req_zone $binary_remote_addr zone=chat_limit:10m rate=1r/s;

server {
    listen 80;
    listen [::]:80;
    server_name YOUR_DOMAIN;
    root /var/www/guishen-ai/dist;
    index index.html;
    client_max_body_size 8m;

    location / { try_files $uri $uri/ /index.html; }

    # 这是网页统一网关，不代表 AstrBot 的真实聊天路径。确认实际协议后才启用。
    location /api/ {
        limit_req zone=chat_limit burst=5 nodelay;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_send_timeout 180s;
        proxy_read_timeout 180s;
        proxy_buffering off;
        proxy_cache off;
        add_header X-Accel-Buffering no;
        proxy_pass http://127.0.0.1:ASTRBOT_OR_PROXY_PORT;
    }

    location ~ ^/(dashboard|admin|manage|swagger|docs|openapi\.json) { return 404; }
}
